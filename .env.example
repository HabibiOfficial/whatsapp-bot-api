# Database
DB_PATH=./data.db

# Baileys session folder
SESSION_DIR=./auth_info_baileys

# Bot info
BOT_NAME=WinaBot
BOT_PREFIX=!

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
