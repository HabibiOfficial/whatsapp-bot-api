# Server
PORT=3000
HOST=0.0.0.0

# Admin dashboard credentials (login pertama kali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT secret untuk sesi dashboard (ganti dengan string random panjang)
