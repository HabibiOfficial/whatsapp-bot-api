# Database (Neon Postgres). Wajib.
# Format: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Dashboard server
PORT=3000
HOST=0.0.0.0

# Admin dashboard credentials (login pertama kali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-change-me-to-a-long-random-string

# Baileys session folder (persistent — di Pterodactyl pastikan folder ini tidak ke-wipe)
SESSION_DIR=./auth_info_baileys

# Bot info
BOT_NAME=WinaBot
BOT_PREFIX=!

# Worker (polling DB untuk outgoing message dari Vercel)
WORKER_POLL_MS=1000
WORKER_BATCH=10

# Logging
LOG_LEVEL=info
